# Absolute origin of the backend API when it is hosted separately from the
# frontend (different domain/port). Leave empty to use the SAME origin as the
# frontend — which is what the dev proxy (vite.config.ts) and the sample
# reverse-proxy (deploy/nginx.conf) assume.
#
# Examples:
#   VITE_API_ORIGIN=http://localhost:8000
#   VITE_API_ORIGIN=https://api.example.com
VITE_API_ORIGIN=