# Backend + agents configuration. Copy to .env and fill in.
# Every variable maps to a field on config.Settings, the only place config is read.

# -- App --
ENVIRONMENT=development
GTMX_LOG_LEVEL=INFO
# text (terminal) or json (one object per line, for a log shipper)
GTMX_LOG_FORMAT=text

# -- Observability (optional; empty = off) --
# Sentry error reporting. Errors are tagged with run_id and user_id; no PII sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# LangSmith agent tracing. Traces include prompts and scraped pages.
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=gtmx
# Comma-separated origins allowed cross-origin. Empty = same-origin only.
ALLOWED_ORIGINS=
# Comma-separated emails granted the admin role at startup.
ADMIN_BOOTSTRAP_EMAILS=

# -- Supabase --
SUPABASE_BASE_URL=
SUPABASE_SECRET_KEY=

# -- Database --
# Defaults to the docker-compose.yml Postgres. In prod, set it to Supabase's
# *session* pooler URI (port 5432): see docs/deploy-render.md.
# DATABASE_URL=postgresql://gtmx:gtmx@localhost:5432/gtmx
# Connections held: SQLAlchemy pool + overflow, plus the agent checkpointer's
# pool. Keep the sum under the database's limit (defaults shown).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# CHECKPOINTER_POOL_SIZE=10

# -- LLM providers --
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
OPENAI_API_KEY=
# Qwen models tried in order (comma-separated). Default: qwen3.7-plus
# LLM_MODELS=qwen3.7-plus
# LLM_CHEAP_MODELS=qwen3.7-plus
# Fallback provider (OpenRouter, uses OPENAI_API_KEY) when every Qwen model fails.
# LLM_FALLBACK_MODELS=openai/gpt-4o-mini
# LLM_CALL_TIMEOUT_S=240
# Max LLM calls in flight per provider; past it calls queue rather than hit 429s.
# LLM_MAX_CONCURRENCY=24
# Hard cap per Exa search/scrape call (its SDK has no timeout).
# EXA_TIMEOUT_S=60
# Event-loop thread pool; each running discovery holds up to two threads.
# DEFAULT_EXECUTOR_WORKERS=256

# -- Web data --
EXA_API_KEY=
BRIGHTDATA_API_KEY=
COMPOSIO_API_KEY=
# Composio auth configs for channels it doesn't manage auth for (TikTok, X):
# create an OAuth app with the provider, add it as an auth config in Composio,
# then: COMPOSIO_AUTH_CONFIGS={"tiktok": "ac_...", "twitter": "ac_..."}
# TODO: X and TikTok are deferred past launch; steps in docs/launch-plan.md#todo
COMPOSIO_AUTH_CONFIGS=
# The SPA origin users return to after connecting an account.
# FRONTEND_BASE_URL=http://localhost:5173   (production: https://app.gtmx.co)

# -- Waitlist (gtmx.co) --
# Resend sends the waitlist confirmation emails. They only reach signups once
# the sending domain is verified in Resend; leave WAITLIST_FROM_EMAIL empty
# until then (signups are still saved).
RESEND_API_KEY=
# WAITLIST_FROM_EMAIL=GTMX <hello@gtmx.co>
# A random secret in production (salts the stored IP hashes).
# WAITLIST_IP_SALT=
# WAITLIST_PILOT_SPOTS=50
# WAITLIST_PILOT_CONTACT_DAYS=14
# WAITLIST_SIGNUPS_PER_IP_PER_HOUR=5
# Header the proxy names the visitor's IP in: x-real-ip (our nginx) or
# x-forwarded-for (Render; the first entry is used).
# CLIENT_IP_HEADER=x-real-ip

# -- Usage limits per user (optional; defaults shown) --
# MAX_ACTIVE_DISCOVERY_RUNS=1
# MAX_DISCOVERY_RUNS_PER_DAY=10
# MAX_COMPETITOR_RUNS_PER_DAY=20
# MAX_ACCOUNT_RUNS_PER_DAY=20
# MAX_REQUESTS_PER_MINUTE=120

# -- Activity tracking (optional; defaults shown) --
# ACTIVITY_HEARTBEAT_S=60       # how often an active customer-app tab pings
# ACTIVITY_MAX_CREDIT_S=120     # most time one ping can credit
# ACTIVITY_SESSION_GAP_S=300    # a longer silence starts a new session

# -- Inbox sync: replies and bounces for sent outreach (optional; defaults shown) --
# INBOX_SYNC_ENABLED=true
# INBOX_SYNC_INTERVAL_S=300
# INBOX_SYNC_WINDOW_DAYS=30

# -- Competitor monitoring (optional; defaults shown) --
# MONITOR_ENABLED=true          # set false on a dev machine to avoid paid runs
# MONITOR_SCAN_INTERVAL_S=3600
# MONITOR_MAX_AGE_H=24
# SOCIALS_MAX_AGE_H=168        # competitor social stats (paid Bright Data scrapes)

# -- Cost reporting (optional; USD list-price estimates, JSON) --
# LLM_PRICES={"qwen3.7-plus": [0.4, 1.2], "openai/gpt-4o-mini": [0.15, 0.6]}   # per 1M input/output tokens
# API_CALL_PRICES={"exa.search": 0.01, "exa.contents": 0.001, "brightdata": 0.0015}

# -- Agent tuning (optional; defaults shown) --
# MARKET_RECENCY_DAYS=365
# COMPETITOR_SEARCH_TIMEOUT_S=20
# COMPETITOR_SCRAPE_TIMEOUT_S=30
# COMPETITOR_PROFILE_WORKERS=6
# ACCOUNT_SEARCH_TIMEOUT_S=20
# ACCOUNT_SCRAPE_TIMEOUT_S=30
# ACCOUNT_ENRICH_WORKERS=6
# ACCOUNT_SOCIALS_WORKERS=6
# ACCOUNT_SEARCH_CACHE_TTL=600
# ACCOUNT_DISCOVERY_FAST=false
