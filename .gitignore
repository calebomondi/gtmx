# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets / environment
.env

# Default local SQLite database + LangGraph checkpointer. Regenerated on
# boot by Base.metadata.create_all (backend/app/main.py). Holds real user
# rows and checkpoint state -- never commit.
blog.db*
checkpoints.db*

# Per-process caches persisted by agents/context_budget.py (distill + offer
# brief condensations). Rebuildable from any run; hundreds of KB of scraped
# page notes never belong in the tree.
agents/.cache/

# Test-run artifacts: per-run notes, final states, and timing reports written
# by the agents/tests/pipelines/ DAG harnesses. Regenerated on every run.
agents/tests/pipelines/_out/

# Stale root-level copy of the LLM client. The live package is agents/llm/,
# which is what every module imports; nothing references this one.
/llm/

# Internal admin console: a separate git repository checked out here.
admin_dashboard/
backend/tests/live/_out/
